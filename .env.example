# ---- Replyo environment ----
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Model used for triage + responses. gpt-4o-mini is cheap and plenty for Step 1.
OPENAI_MODEL=gpt-4o-mini

# Supabase Postgres connection string (used for LangGraph checkpointer + later pgvector).
# IMPORTANT: use the "Session pooler" connection string (host ...pooler.supabase.com, port 5432)
# NOT the transaction pooler on port 6543 — psycopg's prepared statements break under
# pgbouncer transaction mode. Append ?sslmode=require.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Session pooler".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Supabase Auth (multi-tenant dashboard sign-in) ----
# The dashboard signs users in with Supabase Auth (enable Google + Email providers in
# Supabase -> Authentication -> Providers); the API verifies the JWTs those logins issue.
# SUPABASE_URL -> your project URL, used to fetch the JWKS for ES256/RS256 tokens.
# SUPABASE_JWT_SECRET -> only needed if your project still issues HS256 tokens
# (Supabase -> Project Settings -> API -> JWT Secret). Leave blank for JWKS/asymmetric.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=

# ---- Supabase Storage (product images on the catalog) ----
# SUPABASE_SERVICE_ROLE_KEY (Project Settings -> API -> service_role) is the only key
# that may write to a bucket, and it BYPASSES RLS — keep it server-side only, never in
# the dashboard's NEXT_PUBLIC_* env. Leave blank to disable image upload (the endpoints
# then answer 503 and everything else keeps working).
# After setting it, create the bucket once:  uv run python scripts/setup_storage.py
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ---- Google Calendar (Step 4 booking) ----
# Leave BOTH blank to use the in-memory calendar fallback (no setup; for dev/tests).
# To use real Google Calendar:
#   1. Google Cloud Console -> create a project -> enable "Google Calendar API".
#   2. Create a Service Account -> add a JSON key -> download it into this repo
#      (e.g. ./service-account.json — it is git-ignored).
#   3. In Google Calendar, share your clinic calendar with the service account's
#      email (client_email in the JSON), giving "Make changes to events".
#   4. Set the two vars below. GOOGLE_CALENDAR_ID is usually that calendar's id
#      (often your Google account email).
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
CLINIC_TIMEZONE=Asia/Kolkata

# ---- WhatsApp (Meta Cloud API) ----
# Leave blank to disable WhatsApp; everything else still runs.
# Free to test: Meta gives you a test number, and replies to inbound messages are
# free "service conversations". Setup:
#   1. developers.facebook.com -> create an app -> add the "WhatsApp" product.
#   2. Copy the test number's Phone number ID -> WHATSAPP_PHONE_NUMBER_ID.
#      Add your own phone under "To" as a verified recipient (max 5 in dev mode).
#   3. Copy the temporary access token -> WHATSAPP_ACCESS_TOKEN. It expires in 24h;
#      create a System User token for one that doesn't.
#   4. Invent any random string for WHATSAPP_VERIFY_TOKEN.
#   5. Expose the API publicly (WhatsApp needs HTTPS; there's no long-polling):
#        cloudflared tunnel --url http://localhost:8000
#      Then in the Meta app set the Callback URL to
#        https://<tunnel-host>/webhooks/whatsapp
#      paste the same verify token, click Verify and save, and subscribe to "messages".
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Optional: LangSmith tracing ----
# Set LANGSMITH_TRACING=true to see graph traces at https://smith.langchain.com
# (Settings -> API Keys -> Create API Key). The project is created automatically.
#
# LANGSMITH_WORKSPACE_ID is required. Without it an org-scoped key authenticates
# but run ingestion is refused, and the ONLY symptom is a repeating
# "Failed to multipart ingest runs ... 403 Forbidden" in the logs while the
# LangSmith dashboard stays empty. Find it under Settings -> Workspaces, or:
#   curl -s https://api.smith.langchain.com/workspaces -H "x-api-key: $LANGSMITH_API_KEY"
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=replyo
LANGSMITH_WORKSPACE_ID=
